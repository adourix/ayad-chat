{
  "name": "ayad-chat",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @duet/shared build && pnpm --parallel --filter @duet/server --filter @duet/web dev",
    "dev:server": "pnpm --filter @duet/shared build && pnpm --filter @duet/server dev",
    "dev:web": "pnpm --filter @duet/web dev",
    "build": "pnpm --filter @duet/shared --filter @duet/server --filter @duet/web build",
    "typecheck": "pnpm --filter @duet/shared build && pnpm --filter @duet/shared --filter @duet/server --filter @duet/web typecheck",
    "lint": "pnpm --filter @duet/shared --filter @duet/server --filter @duet/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @duet/shared build && pnpm --filter @duet/shared test && pnpm --filter @duet/server test"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
